<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuente de la app: Titillium Web (OFL). Registrada como "AppFont" en MainApplication.kt.
  Los estilos piden pesos altos (800-900); aquí se asignan a archivos más ligeros para que
  el texto no se vea grueso: 400-500 Regular, 600-900 SemiBold.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
  <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/app_font_regular" />
  <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/app_font_regular" />
  <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/app_font_semibold" />
  <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/app_font_semibold" />
  <font android:fontStyle="normal" android:fontWeight="800" android:font="@font/app_font_semibold" />
  <font android:fontStyle="normal" android:fontWeight="900" android:font="@font/app_font_semibold" />
</font-family>
